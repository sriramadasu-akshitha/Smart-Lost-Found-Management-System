<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" %>

<%@ page import="java.sql.*" %>
<%@ page import="lostfound.DBConnection" %>
<%@ page import="java.text.SimpleDateFormat" %>
<%@ page import="java.util.Date" %>

<%
if (session.getAttribute("user_id") == null) {
    response.sendRedirect("login.jsp");
    return;
}

String type = request.getParameter("type");

if (!"LOST".equals(type) && !"FOUND".equals(type)) {
    type = "FOUND";
}

String userName = (String) session.getAttribute("name");
if (userName == null || userName.trim().isEmpty()) {
    userName = "User";
}

String emailValue = (String) session.getAttribute("email");
String phoneValue = (String) session.getAttribute("phone");

if (emailValue == null) emailValue = "";
if (phoneValue == null) phoneValue = "";

String errorMessage = "";

if ("POST".equalsIgnoreCase(request.getMethod())) {

    String itemName = request.getParameter("item_name");
    String category = request.getParameter("category");
    String colour = request.getParameter("colour");
    String brandModel = request.getParameter("brand_model");
    String description = request.getParameter("description");
    String privateDetails = request.getParameter("private_details");
    String location = request.getParameter("location");
    String specificArea = request.getParameter("specific_area");
    String date = request.getParameter("item_date");
    String approxTime = request.getParameter("approx_time");
    String email = request.getParameter("email");
    String phone = request.getParameter("phone");

    String handoverStatus = request.getParameter("handover_status");
    String handoverLocation = request.getParameter("handover_location");

    if (handoverStatus == null) handoverStatus = "";
    if (handoverLocation == null) handoverLocation = "";

    String sql = "INSERT INTO items "
        + "(user_id, item_name, category, description, location, item_date, "
        + "item_type, colour, brand_model, private_details, specific_area, "
        + "approx_time, email, phone, handover_status, handover_location) "
        + "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

    try (Connection con = DBConnection.getConnection();
         PreparedStatement ps = con.prepareStatement(
             sql, Statement.RETURN_GENERATED_KEYS)) {

        int userId = Integer.parseInt(
            String.valueOf(session.getAttribute("user_id"))
        );

        ps.setInt(1, userId);
        ps.setString(2, itemName);
        ps.setString(3, category);
        ps.setString(4, description);
        ps.setString(5, location);
        ps.setDate(6, java.sql.Date.valueOf(date));
        ps.setString(7, type);
        ps.setString(8, colour);
        ps.setString(9, brandModel);
        ps.setString(10, privateDetails);
        ps.setString(11, specificArea);
        ps.setString(12, approxTime);
        ps.setString(13, email);
        ps.setString(14, phone);
        ps.setString(15, handoverStatus);
        ps.setString(16, handoverLocation);

        int result = ps.executeUpdate();

        if (result > 0) {

            // Get the ID generated by the database
            try (ResultSet keys = ps.getGeneratedKeys()) {

                if (keys.next()) {

                    long generatedId = keys.getLong(1);

                    String reportId = "TRC-"
                        + new SimpleDateFormat("yyyy").format(new Date())
                        + "-"
                        + String.format("%05d", generatedId);

                    // Pass report details to the success page
                    session.setAttribute("reportId", reportId);
                    session.setAttribute("itemName", itemName);
                    session.setAttribute("reportType", type);
                    session.setAttribute("reportStatus", "Submitted");

                    session.setAttribute("lastUpdated",
                        new SimpleDateFormat("MMM dd, yyyy • hh:mm a")
                            .format(new Date()));

                    response.sendRedirect("success.jsp");
                    return;

                } else {
                    errorMessage = "Item was saved, but its generated ID could not be retrieved.";
                }
            }
        }

    } catch (Exception e) {
        errorMessage = e.getMessage();
    }
}
%>

<!DOCTYPE html>
<html>
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TRACE | Report <%= type.toLowerCase() %> item</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f6f8;
    color: #263b49;
}

.dashboard {
    display: flex;
    min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
    width: 200px;
    min-width: 200px;
    background: #142e3e;
    color: white;
    display: flex;
    flex-direction: column;
    padding: 22px 15px;
}

.brand {
    height: 65px;
    display: flex;
    align-items: center;
    padding: 0 6px 20px;
    border-bottom: 1px solid #385161;
}

.brand img {
    width: 140px;
    height: 45px;
    object-fit: contain;
}

.nav-menu {
    margin-top: 25px;
}

.nav-menu a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 10px;
    margin-bottom: 7px;
    text-decoration: none;
    color: #e5edf2;
    font-size: 12px;
    border-radius: 9px;
    transition: 0.3s;
}

.nav-menu a:hover {
    background: #29495b;
}

.nav-menu a.active {
    background: #e9aa48;
    color: #172f3e;
    font-weight: bold;
}

.nav-menu a span {
    width: 18px;
    text-align: center;
    font-size: 16px;
}
.nav-icon {
    width: 25px;
    height: 25px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    flex-shrink: 0;
}
.nav-divider {
    height: 1px;
    background: #496071;
    margin: 25px 0;
}

.sidebar-bottom {
    margin-top: auto;
}

.sidebar-bottom a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 10px;
    color: white;
    text-decoration: none;
    font-size: 12px;
    border-radius: 8px;
}

.sidebar-bottom a:hover {
    background: #29495b;
}

/* MAIN CONTENT */

.main-content {
    flex: 1;
    min-width: 0;
}

/* HEADER */

.top-header {
    height: 45px;
    background: white;
    border-bottom: 1px solid #e1e5e8;
    display: flex;
    align-items: center;
    padding: 0 18px;
    font-size: 13px;
    font-weight: 600;
}

/* PAGE CONTENT */

.content {
    max-width: 850px;
    margin: 22px auto;
    padding: 0 20px;
}

.back-link {
    display: inline-block;
    color: #263d4b;
    font-size: 12px;
    font-weight: bold;
    text-decoration: none;
    margin-bottom: 12px;
}

.back-link:hover {
    text-decoration: underline;
}

.page-heading h1 {
    font-size: 24px;
    margin-bottom: 7px;
    color: #172f3e;
}

.page-heading p {
    font-size: 13px;
    line-height: 1.5;
    color: #536574;
    margin-bottom: 18px;
}

/* FORM CARDS */

.form-card {
    background: white;
    border: 1px solid #dce2e6;
    border-radius: 11px;
    padding: 20px 18px;
    margin-bottom: 18px;
}

.form-card h2 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 18px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 17px 15px;
}

.form-group {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    font-size: 11px;
    font-weight: bold;
    margin-bottom: 7px;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    border: 1px solid #cfd7dc;
    border-radius: 9px;
    padding: 9px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    color: #263b49;
    outline: none;
    background: white;
}

.form-group input,
.form-group select {
    height: 36px;
}

.form-group textarea {
    height: 88px;
    resize: vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: #426d85;
    box-shadow: 0 0 0 2px rgba(66,109,133,0.1);
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: #929ba1;
}

/* PRIVATE DETAILS */

.private-heading {
    margin-bottom: 17px;
}

.private-heading h2 {
    margin-bottom: 5px;
}

.private-heading p {
    color: #87939c;
    font-size: 11px;
}

/* HANDOVER INFORMATION */

.radio-option {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid #dce3e7;
    border-radius: 9px;
    padding: 12px;
    margin-bottom: 9px;
    font-size: 11px;
    cursor: pointer;
}

.radio-option input {
    accent-color: #173849;
    cursor: pointer;
}

.handover-location {
    margin-top: 17px;
}

/* BUTTONS */

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 16px;
    margin-bottom: 20px;
}

.btn {
    padding: 10px 17px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: bold;
    text-decoration: none;
    cursor: pointer;
}

.cancel-btn {
    background: white;
    color: #263d4b;
    border: 1px solid #d8dfe3;
}

.submit-btn {
    background: #142e3e;
    color: white;
    border: 1px solid #142e3e;
}

.submit-btn:hover {
    background: #24495d;
}

.cancel-btn:hover {
    background: #f0f3f5;
}

.error-message {
    color: #c62828;
    background: #ffebee;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 15px;
    font-size: 12px;
}

/* RESPONSIVE */

@media(max-width: 750px) {

    .dashboard {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        min-width: 0;
        padding: 12px;
    }

    .brand {
        height: auto;
    }

    .nav-menu {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 12px;
    }

    .nav-menu a {
        margin: 0;
        padding: 10px;
    }

    .sidebar-bottom {
        margin-top: 10px;
    }

    .content {
        padding: 0 14px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }
}

@media(max-width: 420px) {

    .form-card {
        padding: 16px 12px;
    }

    .page-heading h1 {
        font-size: 21px;
    }
}

</style>

</head>

<body>


<div class="dashboard">

    <!-- SIDEBAR -->
    
<!-- SIDEBAR -->
<aside class="sidebar">

    <div class="brand">
        <a href="index.jsp" class="logo">
            <img src="Logo.png" alt="TRACE Logo">
        </a>
    </div>

    <nav class="nav-menu">

        <!-- Dashboard -->
        <a href="menu.jsp">
            <img src="${pageContext.request.contextPath}/home.png"
                 class="nav-icon" alt="Dashboard">
            Dashboard
        </a>

        <!-- Report Lost Item -->
        <a href="item_form.jsp?type=LOST"
           class="<%= "LOST".equals(type) ? "active" : "" %>">
            <img src="${pageContext.request.contextPath}/report_lost.png"
                 class="nav-icon" alt="Lost Item">
            Report Lost Item
        </a>

        <!-- Report Found Item -->
        <a href="item_form.jsp?type=FOUND"
           class="<%= "FOUND".equals(type) ? "active" : "" %>">
            <img src="${pageContext.request.contextPath}/report_found.png"
                 class="nav-icon" alt="Found Item">
            Report Found Item
        </a>

        <!-- View All Items -->
        <a href="view_items.jsp">
            <img src="${pageContext.request.contextPath}/menu.png"
                 class="nav-icon" alt="View Items">
            View All Items
        </a>

        <div class="nav-divider"></div>

        <!-- Profile -->
        <a href="activity.jsp">
            <img src="${pageContext.request.contextPath}/people_icon.png"
                 class="nav-icon" alt="Profile">
            My Activity
        </a>

        <!-- Logout directly below Profile -->
        <a href="logout.jsp">
            <img src="${pageContext.request.contextPath}/exit.png"
                 class="nav-icon" alt="Logout">
            Logout
        </a>

    </nav>

    <!-- Decorative campus illustration -->
    <div class="sidebar-campus">
        <img src="${pageContext.request.contextPath}/UD_21.png"
             alt="Campus Illustration">
    </div>

</aside>


    <!-- MAIN CONTENT -->

    <main class="main-content">

        <header class="top-header">
            Report <%= type.toLowerCase() %> item
        </header>

        <div class="content">

            <a href="menu.jsp" class="back-link">
                ← Back to dashboard
            </a>

            <div class="page-heading">

                <h1>Report a <%= type.toLowerCase() %> item</h1>

                <p>
                    <%= "FOUND".equals(type)
                        ? "A clear report helps return an item without exposing the owner's private details."
                        : "Share enough detail to help the campus community recognise your item. Fields marked * are required."
                    %>
                </p>

            </div>

            <% if (!errorMessage.isEmpty()) { %>
                <div class="error-message">
                    Error: <%= errorMessage %>
                </div>
            <% } %>

            <form method="post"
                  action="item_form.jsp?type=<%= type %>">

                <!-- ITEM INFORMATION -->

                <section class="form-card">

                    <h2>Item information</h2>

                    <div class="form-grid">

                        <div class="form-group">

                            <label>Item name *</label>

                            <input type="text"
                                   name="item_name"
                                   placeholder="e.g. Silver keyring"
                                   required>

                        </div>

                        <div class="form-group">

                            <label>Category *</label>

                            <select name="category" required>

                                <option value="">Select a category</option>
                                <option>Electronics</option>
                                <option>Documents</option>
                                <option>Clothing</option>
                                <option>Accessories</option>
                                <option>Books</option>
                                <option>Others</option>

                            </select>

                        </div>

                        <div class="form-group">

                            <label>Colour *</label>

                            <input type="text"
                                   name="colour"
                                   placeholder="e.g. Silver"
                                   required>

                        </div>

                        <div class="form-group">

                            <label>Brand or model</label>

                            <input type="text"
                                   name="brand_model"
                                   placeholder="If known">

                        </div>

                        <div class="form-group full">

                            <label>Public description *</label>

                            <textarea name="description"
                                      placeholder="Describe visible features only."
                                      required></textarea>

                        </div>

                    </div>

                </section>

                <!-- PRIVATE DETAILS -->

                <section class="form-card">

                    <div class="private-heading">

                        <h2>Private identifying details</h2>

                        <p>
                            Keep ownership-verification details private
                            from the public report.
                        </p>

                    </div>

                    <div class="form-group">

                        <textarea name="private_details"
                                  placeholder="Details that a claimant should be able to verify"></textarea>

                    </div>

                </section>

                <!-- LOCATION AND TIME -->

                <section class="form-card">

                    <h2>
                        <%= "FOUND".equals(type)
                            ? "Found location and time"
                            : "Last known location"
                        %>
                    </h2>

                    <div class="form-grid">

                        <div class="form-group">

                            <label>Campus location *</label>

                            <select name="location" required>

                                <option value="">Select a building</option>
                                <option>Main Building</option>
                                <option>Library</option>
                                <option>Computer Lab</option>
                                <option>Science Block</option>
                                <option>Administrative Block</option>
                                <option>Cafeteria</option>
                                <option>Auditorium</option>
                                <option>Sports Ground</option>
                                <option>Parking Area</option>
                                <option>Other</option>

                            </select>

                        </div>

                        <div class="form-group">

                            <label>Specific area *</label>

                            <input type="text"
                                   name="specific_area"
                                   placeholder="e.g. Cafe seating area"
                                   required>

                        </div>

                        <div class="form-group">

                            <label>
                                Date <%= "FOUND".equals(type) ? "found" : "lost" %> *
                            </label>

                            <input type="date"
                                   name="item_date"
                                   required>

                        </div>

                        <div class="form-group">

                            <label>Approximate time</label>

                            <input type="time"
                                   name="approx_time">

                        </div>

                    </div>

                </section>

                <!-- HANDOVER INFORMATION: FOUND ONLY -->

                <% if ("FOUND".equals(type)) { %>

                <section class="form-card">

                    <h2>Handover information</h2>

                    <label class="radio-option">

                        <input type="radio"
                               name="handover_status"
                               value="CURRENTLY_HAVE"
                               required>

                        I currently have the item.

                    </label>

                    <label class="radio-option">

                        <input type="radio"
                               name="handover_status"
                               value="HANDED_OVER"
                               required>

                        Handed over to campus administration.

                    </label>

                    <div class="form-group handover-location">

                        <label>Handover location</label>

                        <input type="text"
                               name="handover_location"
                               placeholder="e.g. Student Services Desk">

                    </div>

                </section>

                <% } %>

                <!-- CONTACT INFORMATION -->

                <section class="form-card">

                    <h2>Contact information</h2>

                    <div class="form-grid">

                        <div class="form-group">

                            <input type="email"
                                   name="email"
                                   value="<%= emailValue %>"
                                   placeholder="Email address"
                                   required>

                        </div>

                        <div class="form-group">

                            <input type="tel"
                                   name="phone"
                                   value="<%= phoneValue %>"
                                   placeholder="Phone number"
                                   required>

                        </div>

                    </div>

                </section>

                <!-- BUTTONS -->

                <div class="form-actions">

                    <a href="main_menu.jsp"
                       class="btn cancel-btn">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn submit-btn">
                        Submit report
                    </button>

                </div>

            </form>

        </div>

    </main>

</div>

</body>
</html>
